# ============================================
# ConectAi Automações - Environment Variables
# ============================================
# Copie este arquivo para .env e configure conforme necessário

# ============================================
# 🗄️ DATABASE (PostgreSQL)
# ============================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=SenhaSegura123!
POSTGRES_DATABASE=chatwoot_production

# ============================================
# ⚡ REDIS
# ============================================
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=Redis123!

# ============================================
# 🔐 RAILS / SECURITY
# ============================================
RAILS_ENV=production
NODE_ENV=production
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true

# Gerar com: openssl rand -hex 64
SECRET_KEY_BASE=SUBSTITUA_COM_COMANDO_openssl_rand_hex_64

# ============================================
# 🌐 URLs & SSL
# ============================================
FRONTEND_URL=https://seu-dominio.com.br
INTERNAL_HOST_URL=http://rails:3000
FORCE_SSL=true
INSTALLATION_ENV=docker

# ============================================
# 🎨 BRANDING - ConectAi Automações
# ============================================
INSTALLATION_NAME=ConectAi Automações
BRAND_NAME=ConectAi
BRAND_URL=https://conectai.com.br
WIDGET_BRAND_URL=https://conectai.com.br
LOGO_THUMBNAIL=/brand-assets/logo_thumbnail.svg
LOGO=/brand-assets/logo.svg
LOGO_DARK=/brand-assets/logo_dark.svg
TERMS_URL=https://conectai.com.br/termos
PRIVACY_URL=https://conectai.com.br/privacidade
DISPLAY_MANIFEST=false
DEFAULT_LOCALE=pt_BR

# ============================================
# 📧 EMAIL / SMTP
# ============================================
# Deixe em branco para desabilitar email
MAILER_SENDER_EMAIL=noreply@conectai.com.br
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTHENTICATION=plain
SMTP_USERNAME=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-app-google
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_DOMAIN=conectai.com.br

# ============================================
# 💾 STORAGE
# ============================================
# Opções: local, amazon, google, azure
ACTIVE_STORAGE_SERVICE=local

# Se usar S3/CloudFlare R2:
# AWS_ACCESS_KEY_ID=sua-key
# AWS_SECRET_ACCESS_KEY=sua-secret
# S3_BUCKET_NAME=chatwoot-conectai
# AWS_REGION=us-east-1

# ============================================
# 🔔 NOTIFICAÇÕES & INTEGRAÇÕES (OPCIONAIS)
# ============================================
# Slack
# SLACK_CLIENT_ID=seu-client-id
# SLACK_CLIENT_SECRET=seu-client-secret

# Twilio (SMS)
# TWILIO_ACCOUNT_SID=seu-account-sid
# TWILIO_AUTH_TOKEN=seu-auth-token
# TWILIO_PHONE_NUMBER=seu-numero

# Google OAuth
# GOOGLE_OAUTH_CLIENT_ID=seu-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=seu-client-secret

# ============================================
# 📊 MONITORAMENTO (OPCIONAIS)
# ============================================
# Sentry (Error Tracking)
# SENTRY_DSN=sua-sentry-dsn

# NewRelic
# NEW_RELIC_LICENSE_KEY=sua-license-key

# Scout APM
# SCOUT_KEY=sua-scout-key

# ============================================
# 🛠️ DESENVOLVIMENTO (Apenas local)
# ============================================
# RAILS_ENV=development
# NODE_ENV=development
# DEBUG=1
